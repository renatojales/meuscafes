{
  "name": "meuscafes/tarefas-api",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "description": "API REST de tarefas (Slim 4)",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public",
    "test": "phpunit"
  }
}
